# RoadGuard AI - environment variables (copy to .env and fill in)

# --- Database ---
# SQLite (demo, no setup required):
DATABASE_URL=sqlite:///./roadguard.db
# PostgreSQL + PostGIS (production):
# DATABASE_URL=postgresql://roadguard:roadguard@localhost:5432/roadguard

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- AI / Demo ---
DEMO_MODE=true
MODEL_PATH=

# --- Files ---
STORAGE_PATH=./uploads
MAX_UPLOAD_MB=15

# --- CORS ---
CORS_ORIGINS=*

# --- GenAI (OpenAI compatible) ---
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- App ---
DEBUG=true

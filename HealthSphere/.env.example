# ---- Core ----
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
# Docker / production (PostgreSQL)
DATABASE_URL=postgresql+psycopg://healthsphere:healthsphere@localhost:5432/healthsphere
# Simple local development without Docker (SQLite fallback)
# DATABASE_URL=sqlite:///./data/healthsphere.db

# ---- Redis / task queue ----
REDIS_URL=redis://localhost:6379/0
# inline = run jobs in-process (no Redis needed), celery = background workers
TASK_QUEUE_MODE=inline

# ---- Storage (local dev uses filesystem; prod can use S3/MinIO) ----
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=healthsphere-documents
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_SIZE_MB=25

# ---- AI provider (mock | openai | openai_compatible) ----
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# ---- Maps / healthcare discovery (mock | google) ----
MAP_PROVIDER=mock
MAP_API_KEY=

# ---- Email notifications (mock | smtp) ----
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@healthsphere.local

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

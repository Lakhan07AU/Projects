{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API — FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "TASK_QUEUE_MODE": "inline",
        "AI_PROVIDER": "mock"
      },
      "justMyCode": false
    },
    {
      "name": "Web — Next.js (dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      "name": "API — pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q", "--tb=short"],
      "cwd": "${workspaceFolder}/apps/api",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Web)",
      "configurations": ["API — FastAPI (uvicorn)", "Web — Next.js (dev)"],
      "stopAll": true
    }
  ]
}
